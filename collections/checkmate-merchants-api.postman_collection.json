          "id": "1b3997c4-d9d9-4eb8-9eb6-6220645a83ea",
          "name": "Batch merchant search",
          "request": {
            "name": "Batch merchant search",
            "description": {
              "content": "Search for merchants by name (fuzzy) or domain (exact match). Up to 20 queries per request. Each query carries its own `query_id` that is echoed back so callers can correlate responses. Each result contains an `items` array with matched merchants. Name queries return up to `limit` items per result (default 5, max 20). Misses return a single item with `id: null` — there are no 404s.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "merchants",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queries\": [\n    {\n      \"query_id\": \"<string>\",\n      \"type\": \"<string>\",\n      \"value\": \"<string>\",\n      \"region\": \"<string>\",\n      \"limit\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "b8f6673a-2b15-4515-89e2-4483ef7927ef",
              "name": "Per-query results. Each result has an `items` array. A name query with limit > 1 may produce multiple items. Misses have id: null.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "merchants",
                    "search"
                  ],
                  "host": [
                    "{{baseUrl}}"
