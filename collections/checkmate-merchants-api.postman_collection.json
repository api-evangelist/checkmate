        {
          "id": "478a9ac8-0afc-4721-9ef0-06359abd13b4",
          "name": "Batch merchant offer codes",
          "request": {
            "name": "Batch merchant offer codes",
            "description": {
              "content": "Retrieve ranked offer codes for a set of merchants. Up to 20 queries per request. Each result contains an `items` array of codes; misses return an empty `items` array. Add an `idempotency_key` to deduplicate requests; we suggest using `sha256(user_email + date)` or similar.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "merchants",
                "codes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queries\": [\n    {\n      \"query_id\": \"<string>\",\n      \"merchant_id\": \"<string>\",\n      \"idempotency_key\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
