                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"queries\": [\n    {\n      \"query_id\": \"q1\",\n      \"type\": \"name\",\n      \"value\": \"Acme\",\n      \"region\": \"US\",\n      \"limit\": 5\n    }\n  ]\n}",
                  "options": {
