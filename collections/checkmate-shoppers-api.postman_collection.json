          "id": "09bd0d08-4ea0-4d62-8de7-082414506c5e",
          "name": "Batch shopper purchase history",
          "request": {
            "name": "Batch shopper purchase history",
            "description": {
              "content": "Look up purchase history for one or more shoppers identified by SHA-256 hash of their normalised (lowercase-trimmed) email address. Never send raw email addresses. Up to 20 queries per request. Each result contains a flat `items` array of merchant interactions; unknown shoppers return an empty `items` array — there are no 404s.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "shoppers",
                "history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queries\": [\n    {\n      \"query_id\": \"<string>\",\n      \"email_sha256\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
